# Never commit real values. Use *_FILE variables with Docker secrets in production.
LM_PORTAL_URL=https://your-account.logicmonitor.com
LM_ACCESS_ID_FILE=/run/secrets/lm_access_id
LM_ACCESS_KEY_FILE=/run/secrets/lm_access_key
LOCAL_ADMIN_PASSWORD_FILE=/run/secrets/local_admin_password
LOCAL_USER_PASSWORD_FILE=/run/secrets/local_user_password
DATABASE_URL=postgresql+psycopg://network_sla:change-me@postgres:5432/network_sla
JWT_SECRET_FILE=/run/secrets/jwt_secret
ALLOWED_ORIGINS=http://localhost:8080
COLLECTION_CRON=0 6 * * *
